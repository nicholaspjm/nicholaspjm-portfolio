# Cloudflare (and Netlify) read this from the deploy root to set response
# headers. Copied verbatim into out/ by the build.
#
# Baseline security headers on every response. Permissions-Policy only shuts
# off camera/mic/location — the video embeds' autoplay, fullscreen and
# picture-in-picture are untouched. No CSP: inline Next.js scripts, WebGL and
# third-party embeds make a strict one brittle for little gain on a static site.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# _next/static assets are content-hashed, so their URL changes whenever the
# file changes — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps its filename across edits, so cache in the browser for a day:
# fast repeat visits and page-to-page navigation, updates still show next day.
# (Cloudflare's edge cache already serves these near-instantly regardless.)
/images/*
  Cache-Control: public, max-age=86400
/videos/*
  Cache-Control: public, max-age=86400
